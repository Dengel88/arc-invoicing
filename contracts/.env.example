# Arc's public RPC needs no credentials — this is the real, working endpoint.
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Optional, only needed for `forge verify-contract`.
ARC_EXPLORER_API_KEY=
ARC_EXPLORER_VERIFIER_URL=https://explorer.arc.io/api

# NOTE: there is deliberately no PRIVATE_KEY here.
# The deploy script takes its signer from the command line, so the key never has to
# sit in a file. Import it once into an encrypted keystore instead:
#
#   cast wallet import arc-deployer --interactive
#
# then deploy with `--account arc-deployer`. See ../MORNING.md.

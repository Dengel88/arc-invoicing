# Address of the deployed ArcInvoicing contract. Until this is set, the UI loads
# in read-only mode and tells you so.
VITE_CONTRACT_ADDRESS=

# Optional. Defaults to Arc's own public RPC, which needs no credentials.
# VITE_RPC_URL=https://rpc.mainnet.arc.io

# Optional. Set to "true" to point the app at Arc testnet (chain 5042002).
# VITE_USE_TESTNET=false
